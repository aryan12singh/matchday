# MatchDay environment. Copy to .env.local (git-ignored) and fill in.
# Every process.env reference in the codebase must appear here — scripts/repo-check.ts
# fails the build otherwise.

# --- Supabase -----------------------------------------------------------------
# Browser-safe. Anything NEXT_PUBLIC_ ships in the client bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Never import into a client component; repo-check enforces this.
SUPABASE_SERVICE_ROLE_KEY=

# --- Football provider (API-Football, addendum §F) ------------------------------
# SERVER ONLY. Browsers never call the provider (CLAUDE.md invariant 1).
# Dev uses the free 100 req/day tier plus committed cassettes; Pro from ~19 Aug 2026.
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# --- Jobs / scheduling ----------------------------------------------------------
# Shared secret for pg_cron -> pg_net -> /api/jobs/tick. Constant-time compared.
CRON_SECRET=

# --- Notifications (Task 20, post-launch) ---------------------------------------
RESEND_API_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Observability --------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=

# --- App ------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Season bootstrap (Task 9) --------------------------------------------------
# API-Football's own ids for the competition and season to import.
# Premier League is league 39; the season is the starting year, so 2026 = 2026/27.
API_FOOTBALL_LEAGUE_ID=39
API_FOOTBALL_SEASON_YEAR=2026

# --- Local tooling ----------------------------------------------------------------
# Where `pnpm ui:smoke` points its browser. Defaults to http://localhost:3000.
SMOKE_BASE_URL=http://localhost:3000
