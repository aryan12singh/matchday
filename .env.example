# MatchDay environment. Copy to .env.local (git-ignored) and fill in.
# Every process.env reference in the codebase must appear here — scripts/repo-check.ts
# fails the build otherwise.

# --- Supabase -----------------------------------------------------------------
# Browser-safe. Anything NEXT_PUBLIC_ ships in the client bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Never import into a client component; repo-check enforces this.
SUPABASE_SERVICE_ROLE_KEY=

# --- Football provider (API-Football, addendum §F) ------------------------------
# SERVER ONLY. Browsers never call the provider (CLAUDE.md invariant 1).
# Dev uses the free 100 req/day tier plus committed cassettes; Pro from ~19 Aug 2026.
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# --- Jobs / scheduling ----------------------------------------------------------
# Shared secret for pg_cron -> pg_net -> /api/jobs/tick. Constant-time compared.
CRON_SECRET=

# --- Notifications (Task 20, post-launch) ---------------------------------------
RESEND_API_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Observability --------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=

# --- App ------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Season bootstrap (Task 9) --------------------------------------------------
# API-Football's own ids for the competition and season to import.
# Premier League is league 39; the season is the starting year, so 2026 = 2026/27.
API_FOOTBALL_LEAGUE_ID=39
API_FOOTBALL_SEASON_YEAR=2026

# --- Local tooling ----------------------------------------------------------------
# Where `pnpm ui:smoke` points its browser. Defaults to http://localhost:3000.
SMOKE_BASE_URL=http://localhost:3000

# --- ingestion tuning -------------------------------------------------------
# Daily provider request ceiling the tick refuses to cross. Deliberately below the plan's
# real limit so the bootstrap, /ops syncs and cassette capture keep some headroom.
# Unset (or 0) disables the gate.
API_FOOTBALL_DAILY_BUDGET=

# --- scripts/capture-cassettes.ts (dev only) --------------------------------
# Season to record from. The Free plan only serves 2022-2024, so it cannot be the season
# the app runs on — see docs/provider-notes.md.
CASSETTE_SEASON=2024
# Re-record cassettes that already exist on disk.
FORCE=
# Extra event calls the edge-case hunt may spend looking for penalties and own goals.
HUNT_BUDGET=12
# Gap between live requests. The Free tier caps per-minute as well as per-day.
REQUEST_SPACING_MS=7000

# --- scripts/capture-live.ts (dev only) -------------------------------------
# Seconds between the two live samples. Long enough for the match clock to move.
LIVE_GAP_SECONDS=90
# How many in-play fixtures to follow; each costs one request per sample.
LIVE_FOLLOW=3

# --- scripts/bootstrap-season.ts (dev/ops) ----------------------------------
# Which season to load. Matches the label stored on seasons.label.
SEASON_LABEL=2026/27
# 'local' (default, refuses anything but localhost) or 'hosted'.
TARGET=local
# Only read when TARGET=hosted, as an alternative to NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=
